# Signer for the forge scripts. It is never read by them; pass it on the command line,
# expanded by a shell the wrapper starts once this file is loaded:
#   scripts/with-env.sh <network> sh -c 'forge script ... --private-key "$DEPLOYER_PRIVATE_KEY"'
# The single quotes matter: without them the calling shell expands the variable before
# the file is loaded, and Forge gets an empty key. Or use --ledger --sender / --account.
DEPLOYER_PRIVATE_KEY=

TIME_LOCK_DELAY=1
TIME_LOCK_MIN_DELAY=1
MULTISIG_REQUIRED_CONFIRMATIONS=1

# The MultiSig owner set, comma separated and without duplicates.
MULTISIG_OWNERS=0x0a692a271DfAf2d36E46f50269c932511B55e871,0x2B73d814BA2231606f9d856C7C20423915F96711

# Older variable names, still accepted. They are read from MULTISIG_SIGNER_0 upwards until
# one is unset, and only when MULTISIG_OWNERS is empty, so an existing per-network env file
# that uses them keeps working unchanged.
# MULTISIG_SIGNER_0=0x0a692a271DfAf2d36E46f50269c932511B55e871
# MULTISIG_SIGNER_1=0x0a692a271DfAf2d36E46f50269c932511B55e871
# MULTISIG_SIGNER_2=0x2B73d814BA2231606f9d856C7C20423915F96711
# MULTISIG_SIGNER_3=0x2B73d814BA2231606f9d856C7C20423915F96711
# MULTISIG_SIGNER_4=0x2B73d814BA2231606f9d856C7C20423915F96711

# Older variable name, still accepted in env files but ignored by the forge scripts: the
# deployer is whichever signer forge is given on the command line.
DEPLOYER=0x5bC1C4C1D67C5E4384189302BC653A611568a788

VALIDATOR_GROUPS=0xc24baeac0Fd189637112B7e33d22FfF2730aF993,0xb35Be22BccB0dB9dC62967dcF15fEB97C20f854e,0x3D451dd723797b3DE938C5B22412032B6452591A,0x15Ed3f6b79F5Fb9Ef1D99D37314Dd626b3005F0b,0x34649AdA2cB44D851a2103Feaa8922DedDABfc1c,0xc8A81D473992c7c6D3F469A8263F24914625709d,0x81AE1C73A326325216E25ff1af9EA3871195036E,0xD72Ed2e3db984bAC3bB351FE652200dE527eFfcf

# Explorer key for `forge verify-contract`. Celoscan is served by the Etherscan V2 API, so
# this is an etherscan.io key and one key covers every chain in it. foundry.toml prefers
# CELOSCAN_API_KEY and falls back to this name; scripts/verify-contracts.sh reads
# CELOSCAN_API_KEY, CELO_SCAN_API_KEY and ETHERSCAN_API_KEY.
ETHERSCAN_API_KEY=
