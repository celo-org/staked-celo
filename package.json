{
  "name": "staked-celo",
  "version": "1.0.0",
  "description": "A liquid staking derivative for CELO",
  "type": "module",
  "repository": {
    "url": "https://github.com/celo-org/staked-celo"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@celo/devchain-anvil": "17.0.7",
    "@openzeppelin/contracts": "4.4.2",
    "@openzeppelin/contracts-upgradeable": "4.5.2",
    "@types/node": "^24",
    "husky": ">=6",
    "lint-staged": ">=10",
    "prettier": "^2.5.1",
    "prettier-plugin-solidity": "1.0.0-beta.19",
    "solhint": "git+https://github.com/celo-org/solhint.git",
    "typescript": "^5.9"
  },
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "test:scripts": "node --test 'scripts/tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "prepare-devchain": "scripts/prepare-devchain.sh",
    "verify": "scripts/verify-contracts.sh",
    "bytecode:check": "node scripts/bytecode-compat-check.ts --reference scripts/bytecode-reference.json",
    "lint": "yarn run lint:sol && yarn run lint:ts",
    "lint:sol": "prettier --write contracts/*.sol contracts/**/*.sol && solhint **/*.sol --fix --max-warnings 0",
    "lint:sol:ci": "prettier --check contracts/*.sol contracts/**/*.sol && solhint **/*.sol --max-warnings 0",
    "lint:ts": "prettier --write 'scripts/**/*.ts'",
    "lint:ts:ci": "prettier --check 'scripts/**/*.ts'",
    "fmt": "forge fmt test script",
    "fmt:check": "forge fmt --check test script",
    "prepare": "husky install",
    "keys:decrypt": "bash scripts/key_placer.sh decrypt",
    "keys:encrypt": "bash scripts/key_placer.sh encrypt",
    "with-env": "scripts/with-env.sh"
  },
  "author": "Celo Labs Inc.",
  "license": "LGPL-3.0-only",
  "lint-staged": {
    "contracts/**/*.sol": "yarn lint:sol",
    "{test,script}/**/*.sol": "forge fmt",
    "scripts/**/*.ts": "prettier --write"
  }
}
